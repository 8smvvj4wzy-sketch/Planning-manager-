{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planning-ime.local/schemas/jour.schema.json",
  "title": "jour.json — Planning IME (non transmis)",
  "type": "object",
  "required": [
    "structureVersion",
    "date",
    "absences"
  ],
  "additionalProperties": false,
  "properties": {
    "structureVersion": {
      "type": "integer",
      "minimum": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "absences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/absence"
      }
    },
    "renfortsDuJour": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifiant"
      }
    },
    "epingles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifiant"
      }
    },
    "affectationsManuelles": {
      "type": "array",
      "items": {
        "$ref": "https://planning-ime.local/schemas/structure.schema.json#/$defs/creneauType"
      }
    }
  },
  "$defs": {
    "identifiant": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "heure": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "absence": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "educateur",
            "jeune"
          ]
        },
        "id": {
          "$ref": "#/$defs/identifiant"
        },
        "journee": {
          "type": "boolean"
        },
        "debut": {
          "$ref": "#/$defs/heure"
        },
        "fin": {
          "$ref": "#/$defs/heure"
        },
        "motif": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "journee"
          ],
          "properties": {
            "journee": {
              "const": true
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "debut"
                ]
              },
              {
                "required": [
                  "fin"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "debut",
            "fin"
          ],
          "not": {
            "required": [
              "journee"
            ],
            "properties": {
              "journee": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
